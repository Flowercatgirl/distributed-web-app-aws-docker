  <title style="fill:rgb(0, 0, 0);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:Arial, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto">Distributed Web Application Architecture</title>
  <desc style="fill:rgb(0, 0, 0);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:Arial, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto">Three-tier architecture: User Browser connects to Flask App on Ubuntu VM, which connects via SSH to AWS EC2 and via SQL to Docker MySQL container</desc>

  <!-- Background -->
  <rect width="700" height="420" fill="#f8f9fa" rx="12" style="fill:rgb(248, 249, 250);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:Arial, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto"/>

  <!-- Title -->
  <text x="350" y="32" text-anchor="middle" font-size="14" font-weight="700" fill="#1a1a2e" style="fill:rgb(26, 26, 46);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:Arial, sans-serif;font-size:14px;font-weight:700;text-anchor:middle;dominant-baseline:auto">Distributed Web Application — Architecture</text>
  <text x="350" y="50" text-anchor="middle" font-size="11" fill="#6c757d" style="fill:rgb(108, 117, 125);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:Arial, sans-serif;font-size:11px;font-weight:400;text-anchor:middle;dominant-baseline:auto">Flask · AWS EC2 · Docker / MySQL</text>

  <!-- ── TIER 1: USER ── -->
  <rect x="260" y="68" width="180" height="56" rx="8" fill="#e8f4fd" stroke="#4a90d9" stroke-width="1.5" style="fill:rgb(232, 244, 253);stroke:rgb(74, 144, 217);color:rgb(255, 255, 255);stroke-width:1.5px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:Arial, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto"/>
  <text x="350" y="91" text-anchor="middle" font-size="12" font-weight="700" fill="#1a5276" style="fill:rgb(26, 82, 118);stroke:none;color:rgb(255, 255, 255);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:1;font-family:Arial, sans-serif;font-size:12px;font-weight:700;text-anchor:middle;dominant-baseline:auto">User Browser</text>
